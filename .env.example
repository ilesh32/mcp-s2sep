# AWS — scoped IAM user, read-only + narrow delete permissions.
# See README.md for the exact IAM policy this server needs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Safety
AUDIT_LOG_PATH=audit_log.jsonl
TEARDOWN_DISABLED=false

# MCP transport — leave unset for stdio (default). The Docker image
# overrides this to streamable-http on 0.0.0.0:8000; set these to
# override that default.
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
